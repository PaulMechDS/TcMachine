    _debounceOnTime : TIME;
	_debounceOffTime : TIME;

	initDone : BOOL;
    debounceOnTimer : TON;
    debounceOffTimer : TON;
    debouncedValue : BOOL;
    rTrig : R_TRIG;
    fTrig : F_TRIG;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
