    <Property Name="RisingEdge" Id="{cf113e80-6110-450a-8656-3e72decb6eb7}">
      <Declaration><![CDATA[PROPERTY RisingEdge : BOOL
]]></Declaration>
      <Get Name="Get" Id="{130f7724-a5db-4e83-9c33-cf34a48c86ba}">
        <Declaration><![CDATA[]]></Declaration>
        <Implementation>
          <ST><![CDATA[RisingEdge := fTrig.Q;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Run" Id="{a9ece054-d8fc-422e-8693-2457f6756a83}">
      <Declaration><![CDATA[METHOD Run
VAR
	currentRaw : BOOL;
    intermediateValue : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[currentRaw := THIS^.RawInput;

// First cycle init
IF NOT initDone THEN
    debouncedValue := currentRaw;
    initDone := TRUE;
END_IF

// Debounce
debounceOnTimer(
    IN := currentRaw AND NOT debouncedValue,
    PT := _debounceOnTime
);

debounceOffTimer(
    IN := NOT currentRaw AND debouncedValue,
    PT := _debounceOffTime
);

IF debounceOnTimer.Q THEN
    debouncedValue := TRUE;
END_IF;

IF debounceOffTimer.Q THEN
    debouncedValue := FALSE;
END_IF;
	
// Invert
intermediateValue := debouncedValue XOR _invertInput;

// Override
IF _overrideEnable THEN
	_value := _overrideValue;
ELSE
	_value := intermediateValue;
END_IF

rTrig(CLK := _value);
fTrig(CLK := _value);]]></ST>
      </Implementation>
    </Method>
    <Property Name="Value" Id="{a252e364-4f72-4f71-8ec5-9f3aa223f332}">
      <Declaration><![CDATA[PROPERTY Value : BOOL
]]></Declaration>
      <Get Name="Get" Id="{f5498cbb-cfd2-4f08-b9e6-1a27975e859d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Value := _value;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>