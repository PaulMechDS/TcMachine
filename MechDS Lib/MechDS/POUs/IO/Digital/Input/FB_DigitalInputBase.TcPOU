    bInCopyCode : BOOL;
    DebounceOnTime : TIME;
    DebounceOffTime : TIME;
	Invert : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_debounceOnTime := DebounceOnTime;
_debounceOffTime := DebounceOffTime;
_invertInput := Invert;]]></ST>
