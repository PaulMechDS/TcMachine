  <DUT Name="E_CylinderFault" Id="{5445f5fb-8204-4c77-b2de-a8b38b7e21fa}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_CylinderFault :
(
    NONE                    := 0,
    EXTEND_TIMEOUT          := 1,
